#version 450

// 8x8 workgroup size (64 threads per workgroup)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output render target (RGBA8 Storage Image)
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;

// Uniform push constants for camera and animation state
layout(push_constant) uniform PushConstants {
    vec4 cameraPos; // xyz = position, w = time
    vec4 cameraDir; // xyz = forward direction, w = aspect ratio
} push;

struct Sphere {
    vec3 center;
    float radius;
    vec3 color;
};

// Simple ray-sphere intersection test
float intersectSphere(vec3 rayOrigin, vec3 rayDir, Sphere sphere) {
    vec3 oc = rayOrigin - sphere.center;
    float b = dot(oc, rayDir);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    float h = b * b - c;

    if (h < 0.0) return -1.0; // Miss
    return -b - sqrt(h);      // Return nearest hit distance
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);

    // Guard against out-of-bounds invocations
    if (pixelCoords.x >= imgSize.x || pixelCoords.y >= imgSize.y) return;


    // Construct Ray
    vec3 rayOrigin = push.cameraPos.xyz;
    vec3 forward = normalize(push.cameraDir.xyz);
    vec3 right   = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up      = cross(right, forward);

    float aspect = push.cameraDir.w;
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) / vec2(imageSize(outputImage))) * 2.0 - 1.0;
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.x *= push.cameraDir.w; // Multiply by aspect ratio
    uv.x *= aspect;

    vec3 rayDir = normalize(forward + uv.x * right + uv.y * up);

    // Define a animated scene sphere
    float time = push.cameraPos.w;
    Sphere sphere;
    sphere.center = vec3(0.0, sin(time) * 0.5, 3.0);
    sphere.radius = 1.0;
    sphere.color = vec3(0.2, 0.7, 1.0); // Cyan/Blue sphere

    // Light source position
    vec3 lightPos = vec3(2.0, 4.0, 0.0);

    // Compute Intersection
    float t = intersectSphere(rayOrigin, rayDir, sphere);

    vec4 finalColor = vec4(0.1, 0.1, 0.12, 1.0); // Background color (dark gray/blue)

    if (t > 0.0) {
        vec3 hitPoint = rayOrigin + rayDir * t;
        vec3 normal = normalize(hitPoint - sphere.center);

        // Simple Lambertian Diffuse Lighting
        vec3 lightDir = normalize(lightPos - hitPoint);
        float diff = max(dot(normal, lightDir), 0.0);

        // Ambient + Diffuse color
        vec3 ambient = 0.15 * sphere.color;
        vec3 diffuse = diff * sphere.color;

        finalColor = vec4(ambient + diffuse, 1.0);
    }

    // Write final color to the output storage image
    imageStore(outputImage, pixelCoords, finalColor);
}
